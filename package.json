{
  "name": "wa-lead-extractor",
  "version": "1.0.0",
  "description": "Extracts structured lead facts from WhatsApp property conversations without hallucinating, using a staged deterministic-first pipeline and a cite-or-null guardrail.",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "eval": "tsx eval/run-eval.ts",
    "eval:messages": "tsx eval/run-message-eval.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings=0 .",
    "record": "tsx eval/record.ts",
    "score": "tsx eval/score-recording.ts"
  },
  "dependencies": {
    "openai": "^4.68.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.16.11",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^2.1.3"
  }
}
